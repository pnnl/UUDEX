# Copy to .env (git-ignored) and edit. Placeholders only; not for real deployment.
# Environment variables override this file; this file overrides the secrets directory.

# Client certificate header value.
X_SSL_CERT=-----BEGIN%20CERTIFICATE-----%0APLACEHOLDER%0A-----END%20CERTIFICATE-----%0A

# Recommended: keep the database URL and the broker URL out of this file and out of
# the environment. Put each in its own file in the secrets directory
# (see secrets/README.md): postgres_dsn and messagebus_connection.
#
# Allowed but less safe: set them here or as environment variables. Environment
# variables are visible to the same user and to root in /proc/<pid>/environ.
# postgres_dsn=postgresql+asyncpg://USER:PASSWORD@localhost:5432/uudex
# messagebus_connection=rabbitmq://localhost:15672?username=USER&password=PASSWORD
