# Copy to .env.compose (git-ignored). Development-only example values; not for real deployment.
# Role and database names are not secret. Passwords live in secrets/ (see README).
POSTGRES_USER=postgres_user
POSTGRES_DB=uudex

# The verifying proxy. UUDEX_CERTS_DIR is the folder generate-certs.sh wrote (it holds ca.crt,
# localhost.crt and localhost.key; only those three files are mounted). The proxy runs as the
# uid and gid that own localhost.key: run `id -u` and `id -g` as the user who ran the script.
# Left empty on purpose: compose refuses to start until you fill them in.
UUDEX_CERTS_DIR=${HOME}/.config/uudex/tls
UUDEX_PROXY_UID=
UUDEX_PROXY_GID=
# Address the proxy publishes 8443 on. The default keeps it on this machine only.
# UUDEX_PROXY_BIND=127.0.0.1
